@model SkillHubeduardo.Application.DTOs.ExcelImportResult
@{
    ViewData["Title"] = "Resultado de la Importación Excel";
}

<div class="row justify-content-center my-4">
    <div class="col-lg-9">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 p-md-5">
            <h4 class="fw-bold mb-3"><i class="bi bi-check-all text-success me-2"></i> Resumen de la Importación Masiva</h4>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 text-center border">
                        <div class="text-muted small">Filas Procesadas</div>
                        <div class="display-6 fw-bold text-dark">@Model.TotalProcessed</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-success-subtle rounded-3 text-center border border-success">
                        <div class="text-success small fw-bold">Inscripciones Exitosas</div>
                        <div class="display-6 fw-bold text-success">@Model.SuccessfulCount</div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-danger-subtle rounded-3 text-center border border-danger">
                        <div class="text-danger small fw-bold">Filas Rechazadas</div>
                        <div class="display-6 fw-bold text-danger">@Model.RejectedCount</div>
                    </div>
                </div>
            </div>

            @if (Model.RejectedRows.Any())
            {
                <h6 class="fw-bold text-danger mb-3"><i class="bi bi-x-octagon me-1"></i> Detalle de Filas Rechazadas</h6>
                <div class="custom-table-container mb-4">
                    <div class="table-responsive">
                        <table class="table custom-table">
                            <thead>
                                <tr>
                                    <th>Fila #</th>
                                    <th>Motivo del Rechazo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var err in Model.RejectedRows)
                                {
                                    <tr>
                                        <td><span class="badge bg-secondary font-monospace">Fila @err.RowNumber</span></td>
                                        <td class="text-danger small">@err.Reason</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            <div class="d-flex justify-content-between pt-3 border-top">
                <a href="/Enrollments/Import" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-repeat me-1"></i> Cargar Otro Archivo
                </a>
                <a href="/Workshops" class="btn btn-brand rounded-pill px-4">
                    Ir al Catálogo de Talleres
                </a>
            </div>
        </div>
    </div>
</div>