@model IEnumerable<SkillHubeduardo.Application.DTOs.TopWorkshopReportDto>
@{
    ViewData["Title"] = "Reporte Top Talleres";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="fw-bold text-dark mb-1"><i class="bi bi-bar-chart-fill text-warning me-2"></i> Reporte: Talleres con Mayor Demanda</h3>
        <p class="text-muted small mb-0">Listado de talleres ordenados de mayor a menor número de inscripciones activas.</p>
    </div>
    <a href="/Workshops" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
        <i class="bi bi-arrow-left me-1"></i> Volver a Talleres
    </a>
</div>

<div class="custom-table-container">
    <div class="table-responsive">
        <table class="table custom-table">
            <thead>
                <tr>
                    <th>Ranking</th>
                    <th>Código</th>
                    <th>Taller</th>
                    <th>Instructor</th>
                    <th>Horario</th>
                    <th>Cupo Máximo</th>
                    <th class="text-center">Inscritos Activos</th>
                    <th class="text-end">Acción</th>
                </tr>
            </thead>
            <tbody>
                @{ int rank = 1; }
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (rank == 1)
                            {
                                <span class="badge bg-warning text-dark fw-bold px-2 py-1"><i class="bi bi-trophy-fill"></i> #1</span>
                            }
                            else if (rank == 2)
                            {
                                <span class="badge bg-secondary text-white fw-bold px-2 py-1">#2</span>
                            }
                            else if (rank == 3)
                            {
                                <span class="badge bg-danger-subtle text-danger fw-bold px-2 py-1">#3</span>
                            }
                            else
                            {
                                <span class="text-muted fw-bold">#@rank</span>
                            }
                        </td>
                        <td><span class="badge-code font-monospace">@item.Code</span></td>
                        <td><strong class="text-dark">@item.Title</strong></td>
                        <td class="small">@item.InstructorName</td>
                        <td class="small">@item.StartDate.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.MaxCapacity</td>
                        <td class="text-center">
                            <span class="badge bg-primary-subtle text-primary fw-bold fs-6 px-3 py-1 rounded-pill">
                                @item.ActiveEnrollmentsCount
                            </span>
                        </td>
                        <td class="text-end">
                            <a href="/Workshops/Attendees/@item.WorkshopId" class="btn btn-sm btn-outline-brand rounded-pill">
                                Ver Inscritos
                            </a>
                        </td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>
    </div>
</div>