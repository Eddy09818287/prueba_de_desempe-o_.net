@model IEnumerable<SkillHubeduardo.Application.DTOs.EnrollmentResponse>
@{
    var workshop = ViewBag.Workshop as SkillHubeduardo.Application.DTOs.WorkshopResponse;
    ViewData["Title"] = $"Inscritos en {workshop?.Title}";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/Workshops" class="text-decoration-none">Talleres</a></li>
                <li class="breadcrumb-item active" aria-current="page">Inscritos</li>
            </ol>
        </nav>
        <h3 class="fw-bold text-dark mb-0">Participantes Inscritos</h3>
        <p class="text-muted small mb-0">
            Taller: <strong>@workshop?.Title</strong> (@workshop?.Code) &middot; Instructor: @workshop?.InstructorName
        </p>
    </div>
    <div class="d-flex gap-2">
        <span class="badge bg-primary px-3 py-2 rounded-pill font-monospace">
            @Model.Count(e => e.Status == "Active") Activos / @workshop?.MaxCapacity Capacidad
        </span>
        <a href="/Workshops" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i> Volver
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
        <i class="bi bi-people display-4 text-muted mb-3"></i>
        <h5 class="fw-bold">No hay inscripciones registradas</h5>
        <p class="text-muted small">Este taller aún no cuenta con participantes inscritos.</p>
    </div>
}
else
{
    <div class="custom-table-container">
        <div class="table-responsive">
            <table class="table custom-table">
                <thead>
                    <tr>
                        <th>Participante</th>
                        <th>Correo</th>
                        <th>Fecha Inscripción</th>
                        <th>Estado</th>
                        <th class="text-end">Acciones (Empleado)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold text-dark">@e.ParticipantName</div>
                                <div class="text-muted small">ID: @e.ParticipantId</div>
                            </td>
                            <td>@e.ParticipantEmail</td>
                            <td class="small">@e.EnrolledAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (e.Status == "Active")
                                {
                                    <span class="badge-spots badge-spots-available">
                                        <i class="bi bi-check-circle me-1"></i> Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-spots badge-spots-full">
                                        <i class="bi bi-x-circle me-1"></i> Cancelada
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="d-inline-flex gap-2">
                                    @if (e.Status == "Active")
                                    {
                                        <a href="/Enrollments/DownloadCertificate/@e.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Descargar Constancia en PDF">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> PDF
                                        </a>
                                        <form asp-controller="Enrollments" asp-action="Cancel" method="post" onsubmit="return confirm('¿Seguro que deseas cancelar la inscripción de este participante? Como empleado liberarás su cupo.');" class="d-inline">
                                            <input type="hidden" name="id" value="@e.Id" />
                                            <input type="hidden" name="returnUrl" value="/Workshops/Attendees/@workshop?.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" title="Cancelar como Empleado">
                                                <i class="bi bi-slash-circle me-1"></i> Cancelar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small fst-italic">
                                            Cancelado por: @(e.CancelledBy ?? "Sistema") (@(e.CancelledAt?.ToString("dd/MM/yyyy HH:mm") ?? "-"))
                                        </span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}